# Copia este archivo como .env (no se sube al repo) y rellena los valores.
PORT=3000
BASE_URL=http://localhost:3000
ADMIN_USER=admin
ADMIN_PASS=cambia-esto-min-8-caracteres
# Claves de SumUp: en local usa claves de prueba (sandbox), nunca las de producción
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
DB_PATH=./data/alayan.db
ALLOW_CLIENT_AMOUNT=false
