# Copia este archivo como .env (no se sube al repo) y rellena los valores.
PORT=3000
BASE_URL=http://localhost:3000
ADMIN_USER=admin
ADMIN_PASS=cambia-esto-min-8-caracteres
# Claves de SumUp (Dashboard → Developer Settings). Sin ellas y con SUMUP_MOCK=true se simulan los pagos
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
DB_PATH=./data/alayan.db
# true = simular SumUp sin cuenta (solo desarrollo/staging; se ignora si hay API key)
SUMUP_MOCK=true
# Emails (Resend, https://resend.com). Sin clave, se registran en el panel pero no se envían
RESEND_API_KEY=
MAIL_FROM=Alayan Driver <reservas@tu-dominio.es>
# Dónde recibe Alayan los avisos de nuevas reservas y pagos (por defecto, el email de «Datos legales»)
NOTIFY_EMAIL=
